<?xml version="1.0" encoding="utf-8"?>
<!--
   Recent files (including private copies of other people's PDFs) are not
   backed up: they can be large, and persisted file permissions don't
   survive a restore anyway.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="recent/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="recent/" />
    </device-transfer>
</data-extraction-rules>
