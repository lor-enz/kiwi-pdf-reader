<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Material 3, not the plain platform theme: the PDF viewer opens Material dialogs itself (the
      choices of a form's drop-down field), which crash without it. Compose screens use their own
      theme (ui/theme), so this only styles what the viewer draws itself.
    -->
    <style name="Theme.PdfPenguin" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/off_white</item>
        <!--
          The splash screen shows the icon also when another app opens a file, not only from the
          launcher: the viewer's cover continues it with the icon, which otherwise popped up late.
        -->
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
        <!--
          The PDF viewer's fast scroller (page number pill and scroll thumb) reads
          these Material attributes. Without them the page number is black on a
          transparent background and invisible on dark pages.
        -->
        <item name="colorSurfaceContainerHigh">@color/deep_blue</item>
        <item name="colorOnSurface">@color/off_white</item>
        <item name="colorOnSurfaceVariant">@color/off_white</item>
        <item name="colorPrimary">@color/ocean_blue</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PdfPenguin.Dialog</item>
    </style>

    <!-- The viewer's own dialogs, colored like the app's Compose dialogs. -->
    <style name="ThemeOverlay.PdfPenguin.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/ocean_blue</item>
        <item name="colorOnPrimary">@color/off_white</item>
        <item name="colorSurface">@color/off_white</item>
        <item name="colorSurfaceContainerHigh">@color/ice_blue</item>
        <item name="colorOnSurface">@color/charcoal</item>
        <item name="colorOnSurfaceVariant">@color/charcoal</item>
    </style>
</resources>
